---
import '../styles/global.css';
import '@fontsource-variable/bricolage-grotesque';

interface Props {
  title: string;
  description?: string;
  pageClass?: string;
}

const {
  title,
  description = 'Alex Liu — product work, writing, and experiments.',
  pageClass = '',
} = Astro.props;
const base = import.meta.env.BASE_URL;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const navigation = [
  ['Projects', 'projects/'],
  ['Writing', 'writing/'],
  ['About', 'about/'],
];
const relativePath = Astro.url.pathname.replace(base, '/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Alex Liu" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <link rel="alternate" type="application/rss+xml" title="Alex Liu" href={`${base}rss.xml`} />
    <title>{title}</title>
  </head>
  <body class={pageClass}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="top-rule" aria-hidden="true"><i></i><span></span></div>
    <header class="site-header">
      <a class="site-name" href={base}>Alex Liu</a>
      <nav aria-label="Primary navigation">
        {navigation.map(([label, path]) => <a class:list={{ active: relativePath.startsWith(`/${path}`) }} href={`${base}${path}`}>{label}</a>)}
      </nav>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer>
      <span>© {new Date().getFullYear()} Alex Liu</span>
      <span class="footer-note">Built as an independent, portable archive.</span>
      <a href={`${base}rss.xml`}>RSS</a>
    </footer>
    <script is:inline>
      document.documentElement.classList.add('has-js');
      const marker = document.querySelector('.top-rule span');
      const update = () => { const max = document.documentElement.scrollHeight - innerHeight; const progress = max > 0 ? scrollY / max : 0; if (marker) marker.style.transform = `scaleX(${progress})`; };
      addEventListener('scroll', update, { passive: true }); update();
    </script>
  </body>
</html>
