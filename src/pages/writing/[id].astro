---
import { getCollection, render } from 'astro:content';
import FlywheelDiagram from '../../components/FlywheelDiagram.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('writing', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={`${entry.data.title} — Alex Liu`} description={entry.data.description}>
  <article class="writing-article">
    <header class:list={{ 'writing-article__header': true, 'writing-article__header--visual': Boolean(entry.data.visual) }}>
      <div class="writing-article__intro">
        <p class="eyeline">Writing · {entry.data.publishedAt.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })} · {entry.data.readTime ?? 5} 分钟阅读</p>
        <h1 class="display">{entry.data.title}</h1>
        <p class="lede">{entry.data.description}</p>
        {entry.data.source && <p class="writing-article__source">{entry.data.source.note} <a href={entry.data.source.url} target="_blank" rel="noreferrer">阅读英文原文（{entry.data.source.label}）↗</a></p>}
      </div>
      {entry.data.visual === 'two-flywheels' && <FlywheelDiagram />}
    </header>
    <div class="writing-prose"><Content /></div>
    <a class="back-link" href={`${import.meta.env.BASE_URL}writing/`}>返回 Writing</a>
  </article>
</BaseLayout>
