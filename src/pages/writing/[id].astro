---
import { getCollection, render } from 'astro:content';
import FlywheelDiagram from '../../components/FlywheelDiagram.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('writing', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const isEnglishOriginal = entry.id === 'two-flywheels' && entry.data.source;
---

<BaseLayout title={`${entry.data.title} — Alex Liu`} description={entry.data.description}>
  <article class="writing-article">
    <header class:list={{ 'writing-article__header': true, 'writing-article__header--visual': Boolean(entry.data.visual) }}>
      <div class="writing-article__intro">
        <p class="eyeline" data-i18n-en={`Writing · ${entry.data.publishedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })} · ${entry.data.readTime ?? 5} min read`}>Writing · {entry.data.publishedAt.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })} · {entry.data.readTime ?? 5} 分钟阅读</p>
        <h1 class="display" data-i18n-en={isEnglishOriginal ? 'Two Flywheels: A Management Model Built for AI Startups' : undefined}>{entry.data.title}</h1>
        <p class="lede" data-i18n-en={isEnglishOriginal ? 'A structure I stumbled into on my first internship — and have been thinking about ever since.' : undefined}>{entry.data.description}</p>
        {entry.data.source && <p class="writing-article__source" data-language-hidden="en">{entry.data.source.note} <a href={entry.data.source.url} target="_blank" rel="noreferrer">阅读英文原文（{entry.data.source.label}）↗</a></p>}
      </div>
      {entry.data.visual === 'two-flywheels' && <div data-language-hidden="en"><FlywheelDiagram /></div>}
    </header>
    {isEnglishOriginal && <section class="writing-source-handoff" data-language-visible="en" aria-label="English source">
      <p>This site keeps the Chinese adaptation of this essay. The original English version is published on AirJelly.</p>
      <a class="primary-link" href={entry.data.source?.url} target="_blank" rel="noreferrer">Read the English original on AirJelly <span aria-hidden="true">↗</span></a>
    </section>}
    <div class="writing-prose" data-language-hidden="en"><Content /></div>
    <a class="back-link" href={`${import.meta.env.BASE_URL}writing/`} data-i18n-en="Back to Writing">返回 Writing</a>
  </article>
</BaseLayout>
