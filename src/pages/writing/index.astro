---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const entries = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
---

<BaseLayout title="Writing — Alex Liu">
  <section class="writing-intro"><p class="eyeline">Writing</p><h1 class="display">把做过的事，整理成可以讨论的判断。</h1><p class="lede">记录从真实经历、产品实践与团队协作中长出来的观察。</p></section>
  {entries.length === 0 ? (
    <p class="lede writing-empty">第一篇文章正在整理。</p>
  ) : <section class="writing-list" aria-label="文章列表">{entries.map((entry) => <article><a href={`${import.meta.env.BASE_URL}writing/${entry.id}/`}><p>{entry.data.publishedAt.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}</p><h2>{entry.data.title}</h2><p>{entry.data.description}</p>{entry.data.source && <span>{entry.data.source.label} ↗</span>}</a></article>)}</section>}
</BaseLayout>
