---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const entries = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
const [featured, ...remaining] = entries;
---

<BaseLayout title="Writing — Alex Liu">
  <section class="writing-intro"><h1 class="display">Writing</h1><p class="lede" data-i18n-en="Notes on products, AI, and ways of working.">关于产品、AI 和工作方式的一些记录。</p></section>
  {!featured ? (
    <p class="lede writing-empty" data-i18n-en="The first piece is still being prepared.">第一篇文章正在整理。</p>
  ) : <>
    <section class="writing-feature" aria-labelledby="featured-title">
      <div class="writing-feature__visual">
        <img src={`${import.meta.env.BASE_URL}${featured.data.image}`} alt={featured.data.imageAlt} data-i18n-alt-en={featured.data.imageAltEn} />
      </div>
      <div class="writing-feature__copy">
        <p class="writing-feature__meta" data-i18n-en={`${featured.data.publishedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })} · ${featured.data.readTime ?? 5} min read`}>{featured.data.publishedAt.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })} · {featured.data.readTime ?? 5} 分钟阅读</p>
        <h2 id="featured-title" data-i18n-en={featured.data.titleEn}>{featured.data.title}</h2>
        <p data-i18n-en={featured.data.descriptionEn}>{featured.data.description}</p>
        {featured.data.source && <p class="writing-feature__source"><span data-i18n-en={featured.data.source.noteEn ?? 'Originally published elsewhere.'}>{featured.data.source.note}</span> <a href={featured.data.source.url} target="_blank" rel="noreferrer"><span data-i18n-en={`${featured.data.source.label} original ↗`}>{featured.data.source.label} 原文 ↗</span></a></p>}
        <a class="primary-link" href={`${import.meta.env.BASE_URL}writing/${featured.id}/`}><span data-i18n-en="Read">阅读文章</span> <span aria-hidden="true">→</span></a>
      </div>
    </section>
    {remaining.length > 0 && <section class="writing-list" aria-label="更多文章">{remaining.map((entry) => <article><a href={`${import.meta.env.BASE_URL}writing/${entry.id}/`}><img src={`${import.meta.env.BASE_URL}${entry.data.image}`} alt={entry.data.imageAlt} data-i18n-alt-en={entry.data.imageAltEn} loading="lazy" /><div><p data-i18n-en={entry.data.publishedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}>{entry.data.publishedAt.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}</p><h2 data-i18n-en={entry.data.titleEn}>{entry.data.title}</h2><p data-i18n-en={entry.data.descriptionEn}>{entry.data.description}</p></div></a></article>)}</section>}
  </>}
</BaseLayout>
