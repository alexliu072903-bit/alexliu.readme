---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order).slice(0, 2);
const writing = (await getCollection('writing', ({ data }) => !data.draft)).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())[0];
const base = import.meta.env.BASE_URL;
const statusLabel = { 'Public product': '可访问', Historical: '历史项目', Experimental: '实验中', Available: '可使用' };
const statusLabelEn = { 'Public product': 'Public product', Historical: 'Historical', Experimental: 'Experimental', Available: 'Available' };
const projectDescriptionEn: Record<string, string> = {
  'resume-ai': 'A resume rewriting workspace that keeps the resume, job description, and personal evidence in one process.',
  'blink-vibe-test': 'A historical product experiment in cultural context, identity expression, and social sharing on Telegram.',
};
const catMoments = [
  { file: 'cat-close.jpg', alt: '一只猫在室内靠近镜头', className: 'home-stills__workspace' },
  { file: 'cat-portrait.jpg', alt: '一只猫的近景', className: 'home-stills__portrait' },
  { file: 'cat-chair.jpg', alt: '一只猫躺在椅子上', className: 'home-stills__chair' },
];
---

<BaseLayout title="Alex Liu — Product, writing, and field notes" description="Alex Liu 做产品，也把实践变成可以复用的工具。" pageClass="home-page">
  <section class="home-intro">
    <h1 class="visually-hidden">Alex Liu</h1>
    <div class="home-intro__experience" aria-label="实习经历">
      <article>
        <p class="home-intro__label" data-i18n-en="Now">目前</p>
        <h2>Low Entropy AI · AirJelly</h2>
        <p data-i18n-en="AI Product Manager Intern · Shaping AirJelly 2.0 across product architecture, Agent Context, and core features.">AI 产品经理实习生 · 参与 AirJelly 2.0 的产品体系、Agent Context 与核心功能建设。</p>
      </article>
      <article>
        <p class="home-intro__label" data-i18n-en="Previously">此前</p>
        <h2>Emotional Byte AI Inc.</h2>
        <p data-i18n-en="AI Research Intern · Built and tested Blink Vibe Test for cross-cultural social use on Telegram.">AI 研究实习生 · 围绕 Telegram 的跨文化社交场景完成 Blink Vibe Test。</p>
      </article>
    </div>
  </section>

  <section class="home-stills" aria-label="工作之外的日常片段">
    {catMoments.map((moment) => <figure class={moment.className}><img src={`${base}profile/${moment.file}`} alt={moment.alt} loading="eager" /></figure>)}
  </section>

  <section class="home-projects">
    <header><h2 data-i18n-en="Recent projects">近期项目</h2><a href={`${base}projects/`} data-i18n-en="All projects">全部 Projects</a></header>
    <div class="home-projects__list">
      {projects.map((project) => (
        <article>
          <a class="home-project__image" href={`${base}projects/${project.id}/`}><img src={`${base}${project.data.image}`} alt={project.data.imageAlt} loading="lazy" /></a>
          <div><span data-i18n-en={statusLabelEn[project.data.status]}>{statusLabel[project.data.status]}</span><h3><a href={`${base}projects/${project.id}/`}>{project.data.title}</a></h3><p data-i18n-en={projectDescriptionEn[project.id]}>{project.data.description}</p></div>
        </article>
      ))}
    </div>
  </section>

  {writing && <section class="home-writing" aria-labelledby="home-writing-title">
    <header><h2 id="home-writing-title">Writing</h2><a href={`${base}writing/`} data-i18n-en="All writing">全部文章</a></header>
    <div class="home-writing__content">
      <div class="home-writing__copy">
        <p data-i18n-en={`${writing.data.publishedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })} · ${writing.data.readTime ?? 5} min read`}>{writing.data.publishedAt.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })} · {writing.data.readTime ?? 5} 分钟阅读</p>
        <h3><a href={`${base}writing/${writing.id}/`}>{writing.data.title}</a></h3>
        <p>{writing.data.description}</p>
        <a class="primary-link" href={`${base}writing/${writing.id}/`}><span data-i18n-en="Read">阅读文章</span> <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>}
</BaseLayout>
