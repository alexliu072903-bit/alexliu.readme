---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order).slice(0, 2);
const writing = (await getCollection('writing', ({ data }) => !data.draft)).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())[0];
const base = import.meta.env.BASE_URL;
const statusLabel = { 'Public product': '可访问', Historical: '历史项目', Experimental: '实验中', Available: '可使用' };
---

<BaseLayout title="Alex Liu — Product, writing, and field notes" description="Alex Liu 做产品，也把实践变成可以复用的工具。" pageClass="home-page">
  <section class="home-intro">
    <h1 class="visually-hidden">Alex Liu</h1>
    <div class="home-intro__experience" aria-label="实习经历">
      <article>
        <p class="home-intro__label">目前</p>
        <h2>Low Entropy AI · AirJelly</h2>
        <p>AI Product Manager Intern · 核心参与 AirJelly 2.0 多个模块的更新设计与迭代框架。</p>
      </article>
      <article>
        <p class="home-intro__label">此前</p>
        <h2>Emotional Byte AI Inc.</h2>
        <p>AI Research Intern · 从产品研究出发，完成过面向海外用户的消费产品实践。</p>
      </article>
    </div>
  </section>

  <section class="home-projects">
    <header><h2>近期项目</h2><a href={`${base}projects/`}>全部 Projects</a></header>
    <div class="home-projects__list">
      {projects.map((project) => (
        <article>
          <a class="home-project__image" href={`${base}projects/${project.id}/`}><img src={`${base}${project.data.image}`} alt={project.data.imageAlt} loading="lazy" /></a>
          <div><span>{statusLabel[project.data.status]}</span><h3><a href={`${base}projects/${project.id}/`}>{project.data.title}</a></h3><p>{project.data.description}</p></div>
        </article>
      ))}
    </div>
  </section>

  {writing && <section class="home-writing" aria-labelledby="home-writing-title">
    <header><h2 id="home-writing-title">Writing</h2><a href={`${base}writing/`}>全部文章</a></header>
    <div class="home-writing__content">
      <div class="home-writing__copy">
        <p>{writing.data.publishedAt.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })} · {writing.data.readTime ?? 5} 分钟阅读</p>
        <h3><a href={`${base}writing/${writing.id}/`}>{writing.data.title}</a></h3>
        <p>{writing.data.description}</p>
        <a class="primary-link" href={`${base}writing/${writing.id}/`}>阅读文章 <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>}
</BaseLayout>
