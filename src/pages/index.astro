---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
const base = import.meta.env.BASE_URL;
const statusLabel = { 'Public product': '可访问', Historical: '历史项目', Experimental: '实验中', Available: '可使用' };
---

<BaseLayout title="Alex Liu — Product, writing, and field notes" description="Alex Liu 做产品，也把实践变成可以复用的工具。" pageClass="home-page">
  <section class="home-intro">
    <h1>产品、工具与实践。</h1>
    <p>我做过的产品、开源项目和 Skills。</p>
  </section>

  <section class="home-projects">
    <header><h2>近期项目</h2><a href={`${base}projects/`}>全部 Projects</a></header>
    <div class="home-projects__list">
      {projects.map((project) => (
        <article>
          <a class="home-project__image" href={`${base}projects/${project.id}/`}><img src={`${base}${project.data.image}`} alt={project.data.imageAlt} loading="lazy" /></a>
          <div><span>{statusLabel[project.data.status]}</span><h3><a href={`${base}projects/${project.id}/`}>{project.data.title}</a></h3><p>{project.data.description}</p></div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
