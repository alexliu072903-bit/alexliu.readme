---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Alex Liu — Product, writing, and field notes" description="Alex Liu 是一个 AI-native product builder，关注如何在不确定性中保持想象力，并用理性、克制与实践把一部分东西变成现实。" pageClass="home-page">
  <section class="home-hero"><div class="home-hero__copy"><p class="eyeline">Alex Liu · AI-native product builder</p><h1 class="display">在不确定性中保持想象力。</h1></div><aside class="home-hero__aside"><p>用理性、克制与实践，把其中一部分变成现实。</p><a class="text-link" href={`${base}projects/`}>View projects</a></aside></section>
  <div class="thesis-line" aria-label="Working tensions"><span><b>IMAGINE</b>想象力与确定性</span><span><b>CALIBRATE</b>开拓与克制</span><span><b>BUILD</b>理性与命运的推背感</span></div>
  <section class="home-projects"><p class="eyeline">Recent projects</p><div class="project-list">{projects.map((project, index) => <a class="project-row project-row--simple" href={`${base}projects/${project.id}/`}><div class="project-row__index">{String(index + 1).padStart(2, '0')}</div><div class="project-row__title"><h2>{project.data.title}</h2><p>{project.data.description}</p><div class="meta-row"><span class="status">{project.data.status}</span><span class="status">{project.data.source}</span></div></div><div></div></a>)}</div></section>
</BaseLayout>
