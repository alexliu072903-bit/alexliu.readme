---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const categories = ['产品', '开源工具', 'Skill'] as const;
const base = import.meta.env.BASE_URL;
const statusLabel = {
  'Public product': '可访问',
  Historical: '历史项目',
  Experimental: '实验中',
  Available: '可使用',
};
const sourceLabel = { 'Private source': '源码私有', 'Open source': '开源' };
---

<BaseLayout title="Projects — Alex Liu" description="Alex Liu 做过的产品、开源工具和 Skills。" pageClass="projects-page">
  <header class="projects-intro">
    <h1>Projects</h1>
    <p>我做过的产品、开源工具和 Skills。有些仍在运行，有些已经结束，但都留下了可以验证的东西。</p>
  </header>

  {categories.map((category) => {
    const entries = projects.filter((project) => project.data.category === category);
    return (
      <section class:list={['project-group', `project-group--${category === '产品' ? 'products' : category === '开源工具' ? 'tools' : 'skill'}`]}>
        <header class="project-group__head">
          <h2>{category}</h2>
          <span>{entries.length} {entries.length === 1 ? '项' : '项'}</span>
        </header>
        <div class="project-group__list">
          {entries.map((project) => (
            <article class="project-entry">
              <a class="project-entry__image" href={`${base}projects/${project.id}/`} aria-label={`查看 ${project.data.title}`}>
                <img src={`${base}${project.data.image}`} alt={project.data.imageAlt} loading="lazy" />
              </a>
              <div class="project-entry__content">
                <div class="project-entry__status">
                  <span>{statusLabel[project.data.status]}</span>
                  <span>{sourceLabel[project.data.source]}</span>
                </div>
                <h3><a href={`${base}projects/${project.id}/`}>{project.data.title}</a></h3>
                <p>{project.data.description}</p>
                <a class="project-entry__link" href={`${base}projects/${project.id}/`}>查看项目 <span aria-hidden="true">→</span></a>
              </div>
            </article>
          ))}
        </div>
      </section>
    );
  })}
</BaseLayout>
