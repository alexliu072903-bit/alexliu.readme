---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectSpecimen from '../../components/ProjectSpecimen.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Projects — Alex Liu" description="Alex Liu 做过的产品、协议与 Skills：在不确定性中，把一部分想象变成现实。" pageClass="projects-page">
  <section class="projects-hero"><div class="projects-hero__copy"><p class="eyeline">Selected work · 2026</p><h1 class="display">在不确定性中，做出一些可以留下的东西。</h1></div><aside class="projects-hero__aside"><p>这里既有仍可使用的产品，也有已经结束的实验、开放协议和从实践中提炼出的 Skill。</p><p>Public、Private 与 Historical 状态会被如实保留。</p></aside></section>
  <div class="thesis-line" aria-label="Project themes"><span><b>01</b>想象力与确定性</span><span><b>02</b>开拓与克制</span><span><b>03</b>理性与命运的推背感</span></div>
  <section class="project-list" aria-label="Projects">{projects.map((project, index) => <a class="project-row" href={`${base}projects/${project.id}/`}><div class="project-row__index">{String(index + 1).padStart(2, '0')}</div><div class="project-row__title"><h2>{project.data.title}</h2><p>{project.data.description}</p><div class="meta-row"><span class="status">{project.data.type}</span><span class:list={['status', { 'status--historical': project.data.status === 'Historical', 'status--open': project.data.source === 'Open source' }]}>{project.data.status}</span><span class="status">{project.data.source}</span></div></div><div class="project-row__visual"><ProjectSpecimen kind={project.data.specimen} compact /></div></a>)}</section>
</BaseLayout>
