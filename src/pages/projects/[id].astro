---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectSpecimen from '../../components/ProjectSpecimen.astro';
export async function getStaticPaths() { const projects = await getCollection('projects', ({ data }) => !data.draft); return projects.map((project) => ({ params: { id: project.id }, props: { project } })); }
const { project } = Astro.props;
const { Content } = await render(project);
const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const currentIndex = projects.findIndex((entry) => entry.id === project.id);
const nextProject = projects[(currentIndex + 1) % projects.length];
const base = import.meta.env.BASE_URL;
---
<BaseLayout title={`${project.data.title} — Alex Liu`} description={project.data.description} pageClass="project-page"><article class="project-detail"><a class="project-detail__back" href={`${base}projects/`}>← All projects</a><header class="project-detail__head"><div><p class="eyeline">Project journal · {project.data.year}</p><h1>{project.data.title}</h1><p class="project-detail__summary">{project.data.description}</p></div><aside class="project-detail__facts"><dl><dt>Type</dt><dd>{project.data.type}</dd><dt>Status</dt><dd>{project.data.status}</dd><dt>Source</dt><dd>{project.data.source}</dd></dl>{project.data.links.map((link) => <a class="text-link" href={link.url} target="_blank" rel="noreferrer">{link.label}</a>)}</aside></header><div class="project-detail__specimen"><ProjectSpecimen kind={project.data.specimen} /></div><div class="journal"><div class="journal__body"><Content /></div></div><a class="project-next" href={`${base}projects/${nextProject.id}/`}><span>Next project</span><strong>{nextProject.data.title} →</strong></a></article></BaseLayout>
