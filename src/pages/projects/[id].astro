---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const currentIndex = projects.findIndex((entry) => entry.id === project.id);
const nextProject = projects[(currentIndex + 1) % projects.length];
const base = import.meta.env.BASE_URL;
const statusLabel = { 'Public product': '可访问', Historical: '历史项目', Experimental: '实验中', Available: '可使用' };
const sourceLabel = { 'Private source': '源码私有', 'Open source': '开源', 'Public repository': '公开仓库' };
const useBriefLayout = (project.data.brief?.length ?? 0) > 0;
const briefRows = useBriefLayout ? project.data.brief ?? [] : [];
---

<BaseLayout title={`${project.data.title} — Alex Liu`} description={project.data.description} pageClass="project-page">
  <article class:list={['project-detail', { 'project-detail--brief': useBriefLayout }]}>
    {!useBriefLayout && <a class="back-link" href={`${base}projects/`}>← 返回 Projects</a>}

    <header class="project-header">
      <div class="project-header__meta">
        <span>{project.data.category}</span>
        <span>{statusLabel[project.data.status]}</span>
        <span>{sourceLabel[project.data.source]}</span>
        <span>{project.data.year}</span>
      </div>
      {useBriefLayout ? (
        <div class="project-header__title-row project-header__title-row--brief">
          <h1>{project.data.title}</h1>
          {project.data.links.map((link) => <a class="project-header__github" href={link.url} target="_blank" rel="noreferrer">{link.label} <span aria-hidden="true">↗</span></a>)}
        </div>
      ) : <h1>{project.data.title}</h1>}
      <p>{project.data.description}</p>
      {!useBriefLayout && project.data.links.map((link) => <a class="primary-link" href={link.url} target="_blank" rel="noreferrer">{link.label} <span aria-hidden="true">↗</span></a>)}
    </header>

    {useBriefLayout ? (
      <>
        <section class="project-brief" aria-label="项目概览">
          {briefRows.map((row) => (
            <div class="project-brief__row">
              <h2>{row.label}</h2>
              <p>{row.text}</p>
            </div>
          ))}
        </section>

        <figure class="project-figure project-figure--brief">
          <img src={`${base}${project.data.image}`} alt={project.data.imageAlt} />
          <figcaption>{project.data.evidenceCaption ?? '公开 GitHub 仓库，截取于 2026 年 8 月。'}</figcaption>
        </figure>

        {project.data.readme && (
          <section class="readme-excerpt" aria-label="README 使用摘要">
            <header>
              <h2>README：如何开始</h2>
              <a href={project.data.readme.url} target="_blank" rel="noreferrer">完整 README <span aria-hidden="true">↗</span></a>
            </header>
            <ol>{project.data.readme.steps.map((step) => <li>{step}</li>)}</ol>
          </section>
        )}

        <details class="full-note">
          <summary>展开完整项目笔记</summary>
          <div class="project-prose"><Content /></div>
        </details>
      </>
    ) : (
      <>
        <figure class="project-figure">
          <img src={`${base}${project.data.image}`} alt={project.data.imageAlt} />
          <figcaption>真实项目界面或公开仓库，截取于 2026 年 8 月。</figcaption>
        </figure>

        <section class="project-summary" aria-label="项目摘要">
          <div><h2>解决什么</h2><p>{project.data.problem}</p></div>
          <div><h2>我做了什么</h2><p>{project.data.contribution}</p></div>
          <div><h2>现在怎样</h2><p>{project.data.current}</p></div>
        </section>

        <div class="project-prose"><Content /></div>
      </>
    )}

    <a class="next-project" href={`${base}projects/${nextProject.id}/`}>
      <span>下一个项目</span>
      <strong>{nextProject.data.title} →</strong>
    </a>
    {useBriefLayout && <a class="back-link back-link--footer" href={`${base}projects/`}>← 返回 Projects</a>}
  </article>
</BaseLayout>
