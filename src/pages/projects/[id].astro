---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const currentIndex = projects.findIndex((entry) => entry.id === project.id);
const nextProject = projects[(currentIndex + 1) % projects.length];
const base = import.meta.env.BASE_URL;
const statusLabel = { 'Public product': '可访问', Historical: '历史项目', Experimental: '实验中', Available: '可使用' };
const sourceLabel = { 'Private source': '源码私有', 'Open source': '开源', 'Public repository': '公开仓库' };
const statusLabelEn = { 'Public product': 'Public product', Historical: 'Historical', Experimental: 'Experimental', Available: 'Available' };
const sourceLabelEn = { 'Private source': 'Private source', 'Open source': 'Open source', 'Public repository': 'Public repository' };
const categoryLabelEn = { 产品: 'Product', 开源工具: 'Open-source tool', Skill: 'Skill' };
const en = project.data.en;
const useBriefLayout = (project.data.brief?.length ?? 0) > 0;
const briefRows = useBriefLayout ? project.data.brief ?? [] : [];
---

<BaseLayout title={`${project.data.title} — Alex Liu`} description={project.data.description} pageClass="project-page">
  <article class:list={['project-detail', { 'project-detail--brief': useBriefLayout }]}>
    {!useBriefLayout && <a class="back-link" href={`${base}projects/`} data-i18n-en="← Back to Projects">← 返回 Projects</a>}

    <header class="project-header">
      <div class="project-header__meta">
        <span data-i18n-en={categoryLabelEn[project.data.category]}>{project.data.category}</span>
        <span data-i18n-en={statusLabelEn[project.data.status]}>{statusLabel[project.data.status]}</span>
        <span data-i18n-en={sourceLabelEn[project.data.source]}>{sourceLabel[project.data.source]}</span>
        <span>{project.data.year}</span>
      </div>
      {useBriefLayout ? (
        <div class="project-header__title-row project-header__title-row--brief">
          <h1>{project.data.title}</h1>
          {project.data.links.map((link) => <a class="project-header__github" href={link.url} target="_blank" rel="noreferrer"><span data-i18n-en="View source">{link.label}</span> <span aria-hidden="true">↗</span></a>)}
        </div>
      ) : <h1>{project.data.title}</h1>}
      <p data-i18n-en={en?.description}>{project.data.description}</p>
      {!useBriefLayout && project.data.links.map((link) => <a class="primary-link" href={link.url} target="_blank" rel="noreferrer"><span data-i18n-en="View source">{link.label}</span> <span aria-hidden="true">↗</span></a>)}
    </header>

    <div data-language-visible="en">
      <section class="project-brief" aria-label="English project overview">
        {(en?.brief ?? []).map((row) => (
          <div class="project-brief__row"><h2>{row.label}</h2><p>{row.text}</p></div>
        ))}
        <div class="project-brief__row"><h2>Full note</h2><p>The full project note is currently available in Chinese only.</p></div>
      </section>
      {en?.facts && (
        <section class="project-facts" aria-label="Figures">
          <dl>{en.facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}</dl>
          {en.factsNote && <p>{en.factsNote}</p>}
        </section>
      )}
      {project.data.image && (
        <figure class="project-figure project-figure--brief">
          <img src={`${base}${project.data.image}`} alt={en?.imageAlt ?? project.data.imageAlt} />
          {en?.evidenceCaption && <figcaption>{en.evidenceCaption}</figcaption>}
        </figure>
      )}
      {project.data.reactions && en?.reactions && (
        <section class="project-reactions" aria-label="Public reaction">
          <h2>Public reaction</h2>
          <div>{project.data.reactions.map((r, i) => (
            <figure><img src={`${base}${r.image}`} alt={en.reactions![i]?.alt ?? r.alt} loading="lazy" /><figcaption>{en.reactions![i]?.caption}</figcaption></figure>
          ))}</div>
        </section>
      )}
      {project.data.readme && en?.readmeSteps && (
        <section class="readme-excerpt" aria-label="README summary">
          <header>
            <h2>README: Getting started</h2>
            <a href={project.data.readme.url} target="_blank" rel="noreferrer">Full README <span aria-hidden="true">↗</span></a>
          </header>
          <ol>{en.readmeSteps.map((step) => <li>{step}</li>)}</ol>
        </section>
      )}
    </div>

    {useBriefLayout ? (
      <div data-language-hidden="en">
        <section class="project-brief" aria-label="项目概览">
          {briefRows.map((row) => (
            <div class="project-brief__row">
              <h2>{row.label}</h2>
              <p>{row.text}</p>
            </div>
          ))}
        </section>

        {project.data.facts && (
          <section class="project-facts" aria-label="数据">
            <dl>{project.data.facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}</dl>
            {project.data.factsNote && <p>{project.data.factsNote}</p>}
          </section>
        )}
        {project.data.image && (
          <figure class="project-figure project-figure--brief">
            <img src={`${base}${project.data.image}`} alt={project.data.imageAlt ?? project.data.title} />
            {project.data.evidenceCaption && <figcaption>{project.data.evidenceCaption}</figcaption>}
          </figure>
        )}

        {project.data.reactions && (
          <section class="project-reactions" aria-label="公开反馈">
            <h2>公开反馈</h2>
            <div>{project.data.reactions.map((r) => (
              <figure><img src={`${base}${r.image}`} alt={r.alt} loading="lazy" /><figcaption>{r.caption}</figcaption></figure>
            ))}</div>
          </section>
        )}
        {project.data.readme && (
          <section class="readme-excerpt" aria-label="README 使用摘要">
            <header>
              <h2 data-i18n-en="README: Getting started">README：如何开始</h2>
              <a href={project.data.readme.url} target="_blank" rel="noreferrer"><span data-i18n-en="Full README">完整 README</span> <span aria-hidden="true">↗</span></a>
            </header>
            <ol>{project.data.readme.steps.map((step) => <li>{step}</li>)}</ol>
          </section>
        )}

        <details class="full-note">
          <summary data-i18n-en="Read the full project note">展开完整项目笔记</summary>
          <div class="project-prose"><Content /></div>
        </details>
      </div>
    ) : (
      <div data-language-hidden="en">
        {project.data.image && <figure class="project-figure">
          <img src={`${base}${project.data.image}`} alt={project.data.imageAlt ?? project.data.title} />
        </figure>}

        <section class="project-summary" aria-label="项目摘要">
          <div><h2 data-i18n-en="Problem">解决什么</h2><p>{project.data.problem}</p></div>
          <div><h2 data-i18n-en="Contribution">我做了什么</h2><p>{project.data.contribution}</p></div>
          <div><h2 data-i18n-en="Current state">现在怎样</h2><p>{project.data.current}</p></div>
        </section>

        <div class="project-prose"><Content /></div>
      </div>
    )}

    <a class="next-project" href={`${base}projects/${nextProject.id}/`}>
      <span data-i18n-en="Next project">下一个项目</span>
      <strong>{nextProject.data.title} →</strong>
    </a>
    {useBriefLayout && <a class="back-link back-link--footer" href={`${base}projects/`} data-i18n-en="← Back to Projects">← 返回 Projects</a>}
  </article>
</BaseLayout>
