---
interface Props { kind: 'resume' | 'vibe' | 'cairn' | 'starter' | 'sync'; compact?: boolean; }
const { kind, compact = false } = Astro.props;
---
<div class:list={['specimen', `specimen--${kind}`, { 'specimen--compact': compact }]} aria-hidden="true">
  {kind === 'resume' && <div class="resume-ui"><div class="resume-ui__bar"><span>Resume.AI</span><i></i><i></i></div><div class="resume-ui__columns"><div class="resume-ui__source"><b>输入材料</b><span>Resume.pdf</span><span>Product JD</span><span>Obsidian / Projects</span></div><div class="resume-ui__paper"><strong>Alex Liu</strong><em></em><em></em><em></em><em></em></div><div class="resume-ui__dialog"><b>AI 对话</b><p>只使用已选择的真实经历。</p><span>Evidence found</span></div></div></div>}
  {kind === 'vibe' && <div class="vibe-ui"><div class="vibe-ui__locale"><span>EN</span><span>RU</span></div><p class="vibe-ui__question">When plans change at the last minute, you…</p><div class="vibe-ui__answers"><span>turn it into a better story</span><span>rebuild the plan quietly</span><span>ask who changed the rules</span></div><div class="vibe-ui__result">31 questions · a shareable identity</div></div>}
  {kind === 'cairn' && <div class="cairn-ui"><div class="cairn-ui__tree"><span>AGENTS.md</span><span>.cairn/PROTOCOL.md</span><span>cairn/LOG.md</span><span>└ topics/context.md</span></div><div class="cairn-ui__flow"><span>enter project</span><i></i><span>read recent change</span><i></i><span>open one topic</span></div><div class="cairn-ui__status">VALID · 4 topics · 0 unresolved refs</div></div>}
  {kind === 'starter' && <div class="starter-ui"><div class="starter-ui__prompt"><span>$</span> ./setup.sh --vault "My Notes"</div><div class="starter-ui__steps"><span><i>01</i> verify vault and tools</span><span><i>02</i> pin agent + plugin</span><span><i>03</i> patch, build, install</span><span><i>04</i> keep credentials local</span></div><div class="starter-ui__done">Ready in Obsidian</div></div>}
  {kind === 'sync' && <div class="sync-ui"><div class="sync-ui__head"><span>vault / .gitignore</span><b>dry-run</b></div><div class="sync-ui__diff"><span class="removed">- everything leaves the vault</span><span class="added">+ !SKILL/**</span><span class="added">+ !daily/**</span><span class="kept">  .obsidian stays local</span></div><div class="sync-ui__action">2 folders ready · review before push</div></div>}
</div>
